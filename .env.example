# Copy this file to .env and fill in real values. NEVER commit .env.
# Run with: npm run serve:env

# OpenAI key for AI feedback/grading (server-side only). Leave empty to run offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Port and bind address. Keep 127.0.0.1 unless you really need LAN/public access.
PORT=8080
HOST=127.0.0.1

# Required whenever HOST is not 127.0.0.1/localhost: learners must type this code to use AI.
ACADEMY_API_TOKEN=
# Max AI requests per IP per day.
ACADEMY_DAILY_AI_LIMIT=30
